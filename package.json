{
	"name": "@firefoxic/stylelint-config",
	"description": "Shared config for stylelint by firefoxic.",
	"version": "10.0.0",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/stylelint-config#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/stylelint-config/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/stylelint-config.git"
	},
	"type": "module",
	"types": "./dist/stylelint.config.d.ts",
	"exports": {
		".": {
			"types": "./dist/stylelint.config.d.ts",
			"default": "./dist/stylelint.config.js"
		},
		"./syntactic": {
			"types": "./dist/syntactic.d.ts",
			"default": "./dist/syntactic.js"
		},
		"./stylistic": {
			"types": "./dist/stylistic.d.ts",
			"default": "./dist/stylistic.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"./dist"
	],
	"peerDependencies": {
		"stylelint": "^18.0.0"
	},
	"dependencies": {
		"@firefoxic/stylelint-gamut": "^1.0.0",
		"@stylistic/stylelint-plugin": "^6.0.0"
	},
	"scripts": {
		"help": "make help",
		"prepare": "git config --local core.hooksPath .githooks || true"
	},
	"devDependencies": {
		"@firefoxic/oxlint-config": "~0.5",
		"@morev/stylelint-testing-library": "^1",
		"@types/node": "^26",
		"oxlint": "^1",
		"stylelint": "^18",
		"tsrs": "^0.20.1-ts7",
		"vitest": "^5"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.13",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^12.17",
			"onFail": "download"
		}
	},
	"keywords": [
		"config",
		"css",
		"lint",
		"linter",
		"linting",
		"style",
		"stylelint"
	]
}
