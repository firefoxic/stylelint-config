{
	"name": "@firefoxic/stylelint-config",
	"description": "Shared config for stylelint by firefoxic.",
	"version": "9.0.0",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/stylelint-config#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/stylelint-config/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/stylelint-config.git"
	},
	"type": "module",
	"types": "./dist/stylelint.config.d.ts",
	"exports": {
		".": {
			"types": "./dist/stylelint.config.d.ts",
			"default": "./dist/stylelint.config.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"./dist"
	],
	"peerDependencies": {
		"stylelint": "^18.0.0-next.0"
	},
	"dependencies": {
		"@stylistic/stylelint-plugin": "^6.0.0-next.0",
		"stylelint-gamut": "^2.0.1"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"help": "make help",
		"prepack": "pnpm build",
		"prepare": "git config --local core.hooksPath .githooks || true",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@firefoxic/oxlint-config": "~0.5",
		"@types/node": "^26",
		"oxlint": "^1",
		"stylelint": "^18.0.0-next.0",
		"typescript": "^7",
		"vitest": "^5"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.12",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.15",
			"onFail": "download"
		}
	},
	"keywords": [
		"config",
		"css",
		"lint",
		"linter",
		"linting",
		"style",
		"stylelint"
	]
}
